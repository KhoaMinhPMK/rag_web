{
  "name": "bvnhidong",
  "version": "0.1.0",
  "private": true,
  "description": "Hệ thống RAG y tế hỗ trợ chẩn đoán viêm phổi Nhi khoa",
  "author": "Bệnh viện Nhi Đồng",
  "license": "PROPRIETARY",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "pnpm --filter @bvnhidong/web dev",
    "build": "pnpm --filter @bvnhidong/web build",
    "start": "pnpm --filter @bvnhidong/web start",
    "lint": "pnpm --filter @bvnhidong/web lint",
    "typecheck": "pnpm --filter @bvnhidong/web typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "pnpm --filter @bvnhidong/web test",
    "test:watch": "pnpm --filter @bvnhidong/web test:watch",
    "test:coverage": "pnpm --filter @bvnhidong/web test:coverage",
    "test:e2e": "pnpm --filter @bvnhidong/web test:e2e",
    "test:e2e:ui": "pnpm --filter @bvnhidong/web test:e2e:ui",
    "storybook": "pnpm --filter @bvnhidong/web storybook",
    "build-storybook": "pnpm --filter @bvnhidong/web build-storybook",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.14"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
